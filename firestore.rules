rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Authentication & Role Helpers
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isPlatformAdmin() {
      return isAuthenticated() &&
        (request.auth.token.admin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function getGymRole(gymId) {
      let path = /databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(gymId);
      return exists(path) ? get(path).data.role : null;
    }

    function isGymOwner(gymId) {
      return isAuthenticated() &&
        (isPlatformAdmin() ||
         getGymRole(gymId) == 'owner' ||
         get(/databases/$(database)/documents/gyms/$(gymId)).data.ownerUID == request.auth.uid);
    }

    function isGymStaff(gymId) {
      return isAuthenticated() &&
        (isPlatformAdmin() ||
         isGymOwner(gymId) ||
         getGymRole(gymId) == 'coach');
    }

    function isGymMember(gymId) {
      return isAuthenticated() &&
        (isPlatformAdmin() ||
         isGymStaff(gymId) ||
         getGymRole(gymId) == 'member');
    }

    // =========================================================================
    // User Profiles: /users/{uid}
    // =========================================================================

    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isUser(uid) && request.resource.data.role == 'user';
      allow update: if isPlatformAdmin() ||
        (isUser(uid) && request.resource.data.role == resource.data.role);
      allow delete: if isPlatformAdmin();

      // Member's Gym Memberships & Role
      match /memberships/{gymId} {
        allow read: if isUser(uid) || isGymStaff(gymId);
        allow create: if (isUser(uid) && request.resource.data.role == 'member') || isGymStaff(gymId);
        allow update: if isGymOwner(gymId);
        allow delete: if isUser(uid) || isGymStaff(gymId);

        // Member's Credit Wallet
        match /activePlans/{activePlanId} {
          allow read: if isUser(uid) || isGymStaff(gymId);
          allow create, delete: if isGymStaff(gymId);
          allow update: if isGymStaff(gymId) || isUser(uid);
        }
      }
    }

    // =========================================================================
    // Global Lookup: /gymCodes/{joinCode}
    // =========================================================================

    match /gymCodes/{joinCode} {
      allow read: if isAuthenticated();
      allow write: if isPlatformAdmin() || (request.resource.data.gymId != null && isGymOwner(request.resource.data.gymId));
    }

    // =========================================================================
    // Gyms & Subcollections: /gyms/{gymId}
    // =========================================================================

    match /gyms/{gymId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isGymOwner(gymId);

      // Class Schedule
      match /classes/{classId} {
        allow read: if isAuthenticated();
        allow create, delete: if isGymStaff(gymId);
        allow update: if isGymStaff(gymId) || isAuthenticated();
      }

      // Bookings
      match /bookings/{bookingId} {
        allow read: if isAuthenticated();
        allow create: if isUser(request.resource.data.userId) || isGymStaff(gymId);
        allow update: if isGymStaff(gymId) || isUser(resource.data.userId);
        allow delete: if isUser(resource.data.userId) || isGymStaff(gymId);
      }

      // Waitlist
      match /waitlist/{waitlistId} {
        allow read: if isAuthenticated();
        allow create: if isUser(request.resource.data.userId) || isGymStaff(gymId);
        allow delete: if isUser(resource.data.userId) || isGymStaff(gymId);
      }

      // Team (Owners / Coaches)
      match /team/{uid} {
        allow read: if isAuthenticated();
        allow write: if isGymOwner(gymId);
      }

      // Member Roster
      match /members/{uid} {
        allow read: if isGymStaff(gymId) || isUser(uid);
        allow create: if isUser(uid) || isGymStaff(gymId);
        allow update, delete: if isGymStaff(gymId) || isUser(uid);

        // Private Workout Logs & Personal Records (Strictly Private)
        match /workoutLogs/{logId} {
          allow read, write: if isUser(uid) || isPlatformAdmin();
        }
      }

      // Membership Plan Templates
      match /membershipPlans/{planId} {
        allow read: if isAuthenticated();
        allow write: if isGymOwner(gymId);
      }
    }
  }
}
